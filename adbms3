 Q. 6. Consider a STUDENT_RESULT table with columns Student_ID,
 Student_Name, Subject, Marks and Semester. Write SQL queries to (a)
 display all student result records, (b) calculate the average marks, and
 (c) display the average marks subject-wise. Briefly explain the role of
 OLAP in analysing academic performance data.
 -- Create database
 CREATE DATABASE CollegeDB;
 USE CollegeDB;

 -- Create table
 CREATE TABLE STUDENT_RESULT (
     Student_ID INT,
     Student_Name VARCHAR(50),
     Subject VARCHAR(50),
     Marks INT,
     Semester INT
 );

 -- Insert sample records
 INSERT INTO STUDENT_RESULT VALUES
 (1, 'Rahul', 'DBMS', 85, 5),
 (2, 'Amit', 'Java', 90, 5),
 (3, 'Priya', 'DBMS', 75, 5),
 (4, 'Sneha', 'Java', 80, 5),
 (5, 'Rohan', 'Python', 95, 5);

 -- (a) Display all student result records
 SELECT * FROM STUDENT_RESULT;

 -- (b) Calculate average marks
