Q. 1. Create an EMPLOYEE table using range or hash partitioning based
on employee salary or department. Perform DML operations such as
INSERT, UPDATE and DELETE on the partitioned table. Retrieve and
display records from each partition separately using suitable SQL
queries. Explain how records are stored in different partitions.

1. SQL Code
-- Step 1: Create Database
CREATE DATABASE EmployeeDB;

-- Step 2: Select Database
USE EmployeeDB;

-- Step 3: Create EMPLOYEE Table
CREATE TABLE EMPLOYEE (
    emp_id INT NOT NULL,
    emp_name VARCHAR(50),
    department VARCHAR(30),
    salary INT NOT NULL,
    PRIMARY KEY (emp_id, salary)
)
PARTITION BY RANGE (salary) (
    PARTITION P0 VALUES LESS THAN (20000),
    PARTITION P1 VALUES LESS THAN (40000),
    PARTITION P2 VALUES LESS THAN (60000),
    PARTITION P3 VALUES LESS THAN (100001)
);

-- Step 4: Insert Employee Records
INSERT INTO EMPLOYEE VALUES
(1, 'Amit', 'HR', 15000),
(2, 'Neha', 'IT', 25000),
(3, 'Rahul', 'Sales', 35000),
(4, 'Priya', 'IT', 45000),
(5, 'Sneha', 'HR', 55000),
(6, 'Karan', 'Sales', 65000),
(7, 'Pooja', 'Finance', 80000);

-- Step 5: Display All Records
SELECT * FROM EMPLOYEE;

-- Step 6: Display Records from Each Partition
SELECT * FROM EMPLOYEE PARTITION (P0);
SELECT * FROM EMPLOYEE PARTITION (P1);
SELECT * FROM EMPLOYEE PARTITION (P2);
SELECT * FROM EMPLOYEE PARTITION (P3);

-- Step 7: UPDATE Operation
UPDATE EMPLOYEE
SET salary = 30000
WHERE emp_id = 1;

-- Step 8: DELETE Operation
DELETE FROM EMPLOYEE
WHERE emp_id = 2;
 -- Step 9: Display Final Records
 SELECT * FROM EMPLOYEE;

 -- Step 10: Display Partition Information
 SELECT PARTITION_NAME, TABLE_ROWS
 FROM INFORMATION_SCHEMA.PARTITIONS
 WHERE TABLE_SCHEMA = 'EmployeeDB'
 AND TABLE_NAME = 'EMPLOYEE';


2. Partition-Wise Data Storage
 Partition                        Salary Range                     Employee Salary

 P0                               Below 20,000                     15,000

 P1                               20,000-39,999                    25,000, 35,000

 P2                               40,000-59,999                    45,000, 55,000

