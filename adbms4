  customer_id INT PK                sales_id INT PK                 date_id INT PK
  name VARCHAR                      customer_id INT FK              order_date DATE
  city VARCHAR                      product_id INT FK               month INT
  state VARCHAR                     date_id INT FK                  year INT
                                    amount DECIMAL

  Dim_Product
  ------------------
  product_id INT PK
  product_name VARCHAR
